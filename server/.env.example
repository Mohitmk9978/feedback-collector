# Server
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/feedback_collector

# JWT — use a long random string in production
JWT_SECRET=abcdef123456789

# Client URL for CORS (Vite default)
CLIENT_URL=http://localhost:5173

# Optional: email when feedback status changes (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Feedback Collector <noreply@example.com>
